#============= hal_bootctl_default ==============
allow hal_bootctl_default para_block_device:blk_file getattr;

#============= init ==============
allow init proc:file write;

#============= vendor_init ==============
allow vendor_init vts_status_prop:file read;

#============= hal_health_default ==============
allow hal_health_default sysfs:file read;

#============= init ==============
allow init sysfs:file setattr;
allow init sysfs_class:lnk_file read;
